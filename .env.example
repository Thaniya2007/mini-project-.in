# MongoDB Atlas Connection String (Required for Render and Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hospital_waste?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hospital_waste

# JWT Authentication Secret
JWT_SECRET=change-this-to-a-strong-random-secret

# Optional: Comma-separated allowed CORS origins (e.g. your Vercel URL)
# Leave empty or * to allow all origins
CORS_ORIGIN=*

# Server Port (Render sets PORT automatically)
PORT=3000

